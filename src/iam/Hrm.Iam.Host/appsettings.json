{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Json": {
    "IgnoreNull": true,
    "NamingPolicy": "CamelCase"
  },
  "Cors": {},
  "Swagger": {
    "Enable": true,
    "Versions": [ "v1" ],
    "SecuritySchemes": [ "JWT" ],
    "ApiResponseDocumentationPathPrefixes": [ "/v1" ]
  },
  "Middlewares": {
    "ApiResponseWrapper": {
      "IsEnable": true,
      "Includes": [ "^/v1" ],
      "Excludes": [ "^.*\\/swagger$", "^.*\\/health$" ]
    }
  },
  "Authentication": {
    "DefaultAuthenticateScheme": "Bearer",
    "DefaultChallengeScheme": "Bearer",
    "Jwt": {
      "Bearer": {
        "Authority": "",
        "Audience": "",
        "RequireHttpsMetadata": false,
        "IssuerSigningKeys": [],
        "ValidateAudience": false,
        "ValidateIssuerSigningKey": false,
        "ValidateIssuer": false,
        "MaxExpireMinutes": 0
      }
    }
  }
}
