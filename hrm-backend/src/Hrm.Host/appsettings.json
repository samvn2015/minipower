{
  "ConnectionStrings": {
    "AutoMigrate": "false",
    "AppDbContext": ""
  },
  "Cache": {
    "Items": {
      "ConnectionString": {
        "Key": "conn:{dbid}",
        "MemSeconds": 14400
      }
    }
  },
  "Json": {
    "IgnoreNull": true,
    "NamingPolicy": "CamelCase"
  },
  "Cors": {},
  "Swagger": {
    "Enable": true,
    "Versions": ["v1"],
    "SecuritySchemes": ["JWT"],
    "ApiResponseDocumentationPathPrefixes": ["/api", "/v1"]
  },
  "Middlewares": {
    "ApiResponseWrapper": {
      "IsEnable": true,
      "Includes": ["^/api", "^/v1"],
      "Excludes": ["^.*\\/swagger$", "^.*\\/health"]
    }
  },
  "Authentication": {
    "DefaultAuthenticateScheme": "Bearer",
    "DefaultChallengeScheme": "Bearer",
    "Jwt": {
      "Bearer": {
        "Authority": "",
        "Audience": "",
        "RequireHttpsMetadata": false,
        "IssuerSigningKeys": [],
        "ValidateAudience": false,
        "ValidateIssuerSigningKey": false,
        "ValidateIssuer": false,
        "MaxExpireMinutes": 0
      }
    }
  },
  "HealthChecks": {
    "DefaultTimeoutSeconds": 5,
    "MarkStartupCompleteOnApplicationStarted": true
  },
  "OTEL": {
    "Name": "hrm",
    "Tracing": {
      "Endpoint": "http://localhost:4317",
      "Sampler": "ParentBasedRatio",
      "TraceIdRatio": 1.0,
      "AspNetCoreInstrumentation": {
        "ExcludedPathPrefixes": ["/health", "/swagger"]
      }
    },
    "Metric": {
      "Endpoint": "http://localhost:4317"
    },
    "Logging": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
